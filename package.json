{
  "name": "recmp3-cli",
  "version": "0.2.0",
  "description": "Record audio, transcribe with AI, output developer-ready prompts — for humans and AI agents, from a single terminal command.",
  "type": "module",
  "bin": {
    "recmp3": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-COMMERCIAL.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "clipboardy": "^4.0.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.5",
    "env-paths": "^3.0.0",
    "ink": "^5.1.0",
    "ora": "^8.1.1",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "msw": "^2.4.9",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aedneth/recmp3-cli.git"
  },
  "keywords": [
    "cli",
    "audio",
    "recording",
    "transcription",
    "whisper",
    "groq",
    "developer-tools",
    "vibecoding",
    "mcp",
    "ai-agent",
    "agent-native"
  ]
}
