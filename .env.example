# ── Transcription providers ──────────────────────────────────────────────────
# Required for Groq (default provider)
GROQ_API_KEY=

# Optional — only needed if using --provider openai
OPENAI_API_KEY=

# ── Optional overrides ────────────────────────────────────────────────────────
# RECMP3_PROVIDER=groq
# RECMP3_MODEL=whisper-large-v3-turbo
# RECMP3_SOURCE=default
# RECMP3_LANG=
# RECMP3_OUTDIR=
# RECMP3_SKIP_INIT=1
# RECMP3_PLAIN=1

# ── Dev / Debug ───────────────────────────────────────────────────────────────
# RECMP3_DEBUG=1
